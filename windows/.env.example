# DDO News Portal example configuration
# Copy this file to .env, then fill the required values.

# MongoDB connection
# Default MONGODB_URI: mongodb://localhost:27017
# Default DATABASE_NAME: news_portal
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=news_portal

# HTTP server
# PORT is the local bind port.
# SITE_URL is the public canonical base URL without trailing slash.
PORT=8080
SITE_URL=http://localhost:8080

# Site identity
SITE_NAME_SHORT=DDO News
SITE_NAME_LONG=DDO News Portal
# Optional footer contact e-mail. Hidden when empty or invalid.
CONTACT_EMAIL=

# Admin credentials (required)
# ADMIN_PASSWORD_HASH must be a bcrypt hash.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# API authentication (required)
# API_KEY must be exactly 32 uppercase alphanumeric characters.
API_KEY=

# MongoDB collection names (defaults shown)
ARTICLES_COLLECTION=articles
CATEGORIES_COLLECTION=categories
AUTHORS_COLLECTION=authors
NAV_MENU_COLLECTION=nav_menu
BANNERS_COLLECTION=banners
BANNER_STATS_COLLECTION=banner_stats
PAGEVIEWS_COLLECTION=pageviews
MEDIA_COLLECTION=media
PAGES_COLLECTION=pages

# Custom static pages
# When empty, custom pages are served at the URL root (e.g. /szerviz/javitas).
# Set to a path segment (e.g. PAGE_URL_PREFIX=p) to scope them under that prefix
# (e.g. /p/szerviz/javitas) and remove any risk of collision with future routes.
PAGE_URL_PREFIX=

# Appearance
# ICON_PACK must match a folder/logo under static/img.
ICON_PACK=itlife
# Optional exact installed version. Empty selects the newest local version.
ICON_PACK_VERSION=
# Icon packages are read from DIST_UPDATE_BASE_URL/icon-packs/.
ICON_PACK_STORAGE_DIR=data/icon-packs
PRIMARY_COLOR=#0d6efd
# Category navigation: classic (default) or searchable-mega.
CATEGORY_MENU_LAYOUT=classic

# Social links (optional)
SOCIAL_FACEBOOK=
SOCIAL_TWITTER=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=

# Share buttons (comma-separated)
# Default when empty: reddit,twitter,bluesky,copy
SHARE_BUTTONS=reddit,twitter,bluesky,copy

# Meta Pixel (optional)
# The Pixel script is loaded only after explicit marketing cookie consent.
META_PIXEL_ENABLED=false
META_PIXEL_ID=

# Google Analytics (optional)
# The gtag script is loaded only after explicit Analytics consent.
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=
GOOGLE_ANALYTICS_API_SECRET=
VEMETRIC_ENABLED=false
VEMETRIC_TOKEN=

# Built-in first-party analytics (/admin/analytics)
# Cookie-free: visitors are identified by a salted hash that is regenerated
# every day, so no consent banner interaction is required and the data never
# leaves your own MongoDB.
ANALYTICS_ENABLED=true
# Collection holding the raw events.
ANALYTICS_COLLECTION=analytics_events
# Raw events are dropped by a TTL index after this many days. 0 = keep forever.
ANALYTICS_RETENTION_DAYS=400
# IANA timezone used to bucket days and hours in the reports.
ANALYTICS_TIMEZONE=Europe/Budapest
# Skip visitors sending DNT: 1 or Sec-GPC: 1 (reduces measured traffic).
ANALYTICS_RESPECT_DNT=false

# IndexNow / Bing (optional, leave empty to disable)
# If set, /{INDEXNOW_KEY}.txt will serve the verification key.
INDEXNOW_KEY=

# S3-compatible image storage (optional)
# If all four S3 values are set, media upload/import features become available.
# Endpoint examples:
#   S3_ENDPOINT=https://s3.example.com
#   S3_ENDPOINT=s3.eu-central-2.myqnapcloud.io
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# OIDC portal user login (optional)
# Required for comments, marketplace user actions, and forum posting.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional. If empty, defaults to SITE_URL + /auth/callback.
OIDC_REDIRECT_URL=

# Self-update source (optional)
# Default: https://raw.githubusercontent.com/nagylakas/ddo-news-portal-dist/main
DIST_UPDATE_BASE_URL=https://raw.githubusercontent.com/nagylakas/ddo-news-portal-dist/main

# Marketplace / apróhirdetés module
# Can also be toggled from /admin/plugins. Restart required after changes.
MARKETPLACE_ENABLED=false
# Optional external URL used in the navbar when MARKETPLACE_ENABLED=false.
MARKETPLACE_EXTERNAL=
MARKETPLACE_LISTINGS_COLLECTION=marketplace_listings
MARKETPLACE_CATEGORIES_COLLECTION=marketplace_categories
MARKETPLACE_MESSAGES_COLLECTION=marketplace_messages
MARKETPLACE_REVIEWS_COLLECTION=marketplace_reviews
MARKETPLACE_FAVORITES_COLLECTION=marketplace_favorites
MARKETPLACE_DELIVERY_TYPES_COLLECTION=marketplace_delivery_types
MARKETPLACE_HISTORY_COLLECTION=marketplace_listing_history
MARKETPLACE_REPORTS_COLLECTION=marketplace_reports

# Forum module
# Can also be toggled from /admin/plugins. Restart required after changes.
# Posting uses the same OIDC portal user sessions as comments and marketplace.
FORUM_ENABLED=false
# Optional external URL used in the navbar when FORUM_ENABLED=false.
FORUM_EXTERNAL=
FORUM_CATEGORIES_COLLECTION=forum_categories
FORUM_TOPICS_COLLECTION=forum_topics
FORUM_POSTS_COLLECTION=forum_posts

# Webshop module
# Can also be toggled from /admin/plugins. Restart required after changes.
WEBSHOP_ENABLED=false
# Optional external URL used in the navbar when WEBSHOP_ENABLED=false.
WEBSHOP_EXTERNAL=
WEBSHOP_PRODUCTS_COLLECTION=webshop_products
WEBSHOP_CATEGORIES_COLLECTION=webshop_categories
WEBSHOP_MANUFACTURERS_COLLECTION=webshop_manufacturers
WEBSHOP_ORDERS_COLLECTION=webshop_orders
WEBSHOP_CARTS_COLLECTION=webshop_carts
WEBSHOP_SHIPPING_METHODS_COLLECTION=webshop_shipping_methods
WEBSHOP_PAYMENT_METHODS_COLLECTION=webshop_payment_methods
WEBSHOP_PRODUCT_METHOD_RULES_COLLECTION=webshop_product_method_rules
WEBSHOP_INVENTORY_BATCHES_COLLECTION=webshop_inventory_batches
WEBSHOP_INVENTORY_MOVEMENTS_COLLECTION=webshop_inventory_movements
WEBSHOP_PRICE_HISTORY_COLLECTION=webshop_price_history
WEBSHOP_REVIEWS_COLLECTION=webshop_reviews
WEBSHOP_SUPPLIER_SOURCES_COLLECTION=webshop_supplier_sources
